# Sao chép thành .env rồi điền thông tin dự án Supabase.
VITE_SUPABASE_URL=https://mlucfbtoznfuozdwiufn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TxXLBEGaKgSgjgN3bvSilA_VEVKn-M2
# Chỉ dùng publishable key (hoặc anon key cũ); tuyệt đối không dùng service_role/secret key.
# Biến có tiền tố VITE_ sẽ được công khai trong mã trình duyệt.
# Tùy chọn: TURN, nhiều URL ngăn cách bằng dấu phẩy.
# Khi phát hành, dùng thông tin TURN ngắn hạn; không nhúng mật khẩu dài hạn vào app.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
