{
  "name": "ban-tron-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.*",
    "test:peers": "node scripts/peers.mjs",
    "test:local": "node scripts/local-peers.mjs",
    "test:voice": "VOICE_TEST=1 node scripts/local-peers.mjs",
    "test:nature": "NATURE_TEST=1 PEERS=3 node scripts/local-peers.mjs",
    "test:safety": "SAFETY_TEST=1 PEERS=3 node scripts/local-peers.mjs",
    "test:churn": "CHURN_TEST=1 PEERS=10 node scripts/local-peers.mjs",
    "test:mobile": "MOBILE_TEST=1 PEERS=3 node scripts/local-peers.mjs",
    "check:release": "node scripts/check-release.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "0.5.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "8.3.6"
  }
}
